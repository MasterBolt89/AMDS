        "type": "object",
        "required": [
          "metric_name",
          "unit",
          "baseline",
          "series"
        ],
        "title": "DomainMetricDetail"
      },
      "DomainSummary": {
        "properties": {
          "domain_id": {
            "$ref": "#/components/schemas/DomainId"
          },
          "domain_category": {
            "$ref": "#/components/schemas/DomainCategory"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "measurement_scope_notice": {
            "type": "string",
            "title": "Measurement Scope Notice"
          },
