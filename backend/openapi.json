          },
          "mean": {
            "type": "number",
            "title": "Mean"
          },
          "std_dev": {
            "type": "number",
            "title": "Std Dev"
          },
          "sample_count": {
            "type": "integer",
            "title": "Sample Count"
          }
        },
        "type": "object",
        "required": [
          "window_label",
          "is_validated_standard",
          "mean",
          "std_dev",
          "sample_count"
        ],
        "title": "DomainMetricBaseline"
      },
      "DomainMetricDetail": {
        "properties": {
          "metric_name": {
            "type": "string",
            "title": "Metric Name"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "baseline": {
            "$ref": "#/components/schemas/DomainMetricBaseline"
          },
          "series": {
            "items": {
              "$ref": "#/components/schemas/MetricSeriesPoint"
            },
            "type": "array",
            "title": "Series"
