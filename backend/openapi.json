{
  "openapi": "3.1.0",
  "info": {
    "title": "NASA Astronaut Health Monitoring & Intelligence Engine",
    "description": "Deterministic Health Intelligence and Multimodal Telemetry System for Long-Duration Space Missions.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/astronauts": {
      "get": {
        "tags": [
          "Astronauts & Dashboard"
        ],
        "summary": "List Astronauts",
        "description": "Lists all active astronauts in the system.",
        "operationId": "list_astronauts_api_v1_astronauts_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AstronautSummary"
                  },
                  "type": "array",
                  "title": "Response List Astronauts Api V1 Astronauts Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/astronauts/{astronaut_id}/dashboard": {
      "get": {
        "tags": [
          "Astronauts & Dashboard"
        ],
        "summary": "Get Astronaut Dashboard",
        "description": "Master Dashboard Overview: Returns the complete 9-domain health status,\n\ndeterministic baseline-drift findings, actionable recommendations, and operational risk metrics.",
        "operationId": "get_astronaut_dashboard_api_v1_astronauts__astronaut_id__dashboard_get",
        "parameters": [
          {
            "name": "astronaut_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Astronaut Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/astronauts/{astronaut_id}/domains/{domain_id}": {
      "get": {
        "tags": [
          "Domains & Time-Series"
        ],
        "summary": "Get Domain Detail",
        "description": "Returns domain status, scope notice, cadence policy, and detailed metric baselines and time-series points.",
        "operationId": "get_domain_detail_api_v1_astronauts__astronaut_id__domains__domain_id__get",
        "parameters": [
          {
            "name": "astronaut_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Astronaut Id"
            }
          },
          {
            "name": "domain_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Domain Id"
            }
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(7d|30d|mission)$",
              "default": "30d",
              "title": "Range"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/telemetry/batch": {
      "post": {
        "tags": [
          "Telemetry Ingestion"
        ],
        "summary": "Ingest Telemetry Batch",
        "description": "Ingests a batch of telemetry measurements with strict provenance, modality, and quality validation.\n\nAutomatically triggers closed-loop reassessment evaluation if an acknowledged intervention's\nreassess_after window has elapsed.",
        "operationId": "ingest_telemetry_batch_api_v1_telemetry_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchTelemetryIngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchTelemetryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/astronauts/{astronaut_id}/assessments/history": {
      "get": {
        "tags": [
          "Assessment History"
        ],
        "summary": "Get Assessment History",
        "description": "Returns chronological log of domain assessment evaluations and status transitions.",
        "operationId": "get_assessment_history_api_v1_astronauts__astronaut_id__assessments_history_get",
        "parameters": [
          {
            "name": "astronaut_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Astronaut Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentHistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommendations/{rec_id}/acknowledge": {
      "post": {
        "tags": [
          "Recommendations & Reassessment"
        ],
        "summary": "Acknowledge Recommendation",
        "description": "Acknowledges an active health recommendation, recording the astronaut's intervention (t0)\n\nand initiating the deterministic reassessment evaluation window.",
        "operationId": "acknowledge_recommendation_api_v1_recommendations__rec_id__acknowledge_post",
        "parameters": [
          {
            "name": "rec_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Rec Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationAcknowledgeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationAcknowledgeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/astronauts/{astronaut_id}/operational-risks": {
      "get": {
        "tags": [
          "Operational Risks"
        ],
        "summary": "List Operational Risks",
        "description": "Returns all event-based operational incidents (EVA issues, hypoxia, DCS concerns, dynamic load events).",
        "operationId": "list_operational_risks_api_v1_astronauts__astronaut_id__operational_risks_get",
        "parameters": [
          {
            "name": "astronaut_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Astronaut Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OperationalRiskResponse"
                  },
                  "title": "Response List Operational Risks Api V1 Astronauts  Astronaut Id  Operational Risks Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Operational Risks"
        ],
        "summary": "Create Operational Risk",
        "description": "Logs a discrete event-based operational risk incident.",
        "operationId": "create_operational_risk_api_v1_astronauts__astronaut_id__operational_risks_post",
        "parameters": [
          {
            "name": "astronaut_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Astronaut Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperationalRiskCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationalRiskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulation/scenarios": {
      "get": {
        "tags": [
          "Simulation & Scenarios"
        ],
        "summary": "List Simulation Scenarios",
        "description": "Lists the 4 available deterministic judge demonstration scenarios.",
        "operationId": "list_simulation_scenarios_api_v1_simulation_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationScenarioListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulation/load": {
      "post": {
        "tags": [
          "Simulation & Scenarios"
        ],
        "summary": "Load Simulation Scenario",
        "description": "Loads a deterministic SIMULATED scenario, resets astronaut baseline telemetry,\n\nexecutes the deterministic intelligence engine, and returns the refreshed DashboardResponse.",
        "operationId": "load_simulation_scenario_api_v1_simulation_load_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationLoadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Healthcheck",
        "description": "Basic healthcheck endpoint.",
        "operationId": "healthcheck_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthcheck Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssessmentHistoryItem": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "domain_id": {
            "$ref": "#/components/schemas/DomainId"
          },
          "previous_status": {
            "$ref": "#/components/schemas/AssessmentStatus"
          },
          "new_status": {
            "$ref": "#/components/schemas/AssessmentStatus"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "domain_id",
          "previous_status",
          "new_status",
          "reason"
        ],
        "title": "AssessmentHistoryItem"
      },
      "AssessmentHistoryResponse": {
        "properties": {
          "astronaut_id": {
            "type": "string",
            "title": "Astronaut Id"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/AssessmentHistoryItem"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "astronaut_id",
          "history"
        ],
        "title": "AssessmentHistoryResponse"
      },
      "AssessmentStatus": {
        "type": "string",
        "enum": [
          "NORMAL",
          "ATTENTION",
          "CRITICAL",
          "INSUFFICIENT_DATA"
        ],
        "title": "AssessmentStatus"
      },
      "AstronautSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "callsign": {
            "type": "string",
            "title": "Callsign"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "mission_day": {
            "type": "integer",
            "title": "Mission Day"
          }
        },
        "type": "object",
        "required": [
          "id",
          "callsign",
          "role",
          "mission_day"
        ],
        "title": "AstronautSummary"
      },
      "BatchTelemetryIngestRequest": {
        "properties": {
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/TelemetryMeasurementItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "Measurements"
          }
        },
        "type": "object",
        "required": [
          "measurements"
        ],
        "title": "BatchTelemetryIngestRequest"
      },
      "BatchTelemetryResponse": {
        "properties": {
          "ingested_count": {
            "type": "integer",
            "title": "Ingested Count"
          },
          "rejected_count": {
            "type": "integer",
            "title": "Rejected Count"
          },
          "reassessment_evaluations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Reassessment Evaluations"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "ingested_count",
          "rejected_count",
          "message"
        ],
        "title": "BatchTelemetryResponse"
      },
      "CadencePolicy": {
        "properties": {
          "expected_interval_hours": {
            "type": "number",
            "title": "Expected Interval Hours"
          },
          "stale_after_hours": {
            "type": "number",
            "title": "Stale After Hours"
          },
          "minimum_valid_samples_for_baseline": {
            "type": "integer",
            "title": "Minimum Valid Samples For Baseline"
          }
        },
        "type": "object",
        "required": [
          "expected_interval_hours",
          "stale_after_hours",
          "minimum_valid_samples_for_baseline"
        ],
        "title": "CadencePolicy"
      },
      "DashboardResponse": {
        "properties": {
          "astronaut": {
            "$ref": "#/components/schemas/AstronautSummary"
          },
          "mission_context": {
            "$ref": "#/components/schemas/MissionContext"
          },
          "data_provenance_summary": {
            "$ref": "#/components/schemas/DataProvenanceSummary"
          },
          "domains": {
            "items": {
              "$ref": "#/components/schemas/DomainSummary"
            },
            "type": "array",
            "title": "Domains"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/RecommendationItem"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "operational_risk_records_count": {
            "type": "integer",
            "title": "Operational Risk Records Count"
          }
        },
        "type": "object",
        "required": [
          "astronaut",
          "mission_context",
          "data_provenance_summary",
          "domains",
          "findings",
          "recommendations",
          "operational_risk_records_count"
        ],
        "title": "DashboardResponse"
      },
