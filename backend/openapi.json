        "title": "DataQuality"
      },
      "DomainCategory": {
        "type": "string",
        "enum": [
          "PERSONAL_HEALTH",
          "ENVIRONMENTAL_ECLSS"
        ],
        "title": "DomainCategory"
      },
      "DomainDetailResponse": {
        "properties": {
